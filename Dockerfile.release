# =========================================================================
# Aarkam AM CLI — Sovereign Fabric Management Utility (v1.0.2)
# Production Container Image (Option A: Release Artifact Distribution)
# =========================================================================
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS runtime

LABEL org.opencontainers.image.title="Aarkam AM CLI" \
      org.opencontainers.image.description="Unified command-line interface & interactive REPL for Aarkam Sovereign Storage Fabric" \
      org.opencontainers.image.version="1.0.2" \
      org.opencontainers.image.vendor="Aarkam.IO" \
      org.opencontainers.image.licenses="Proprietary"

# Install network utilities, TLS certificates, and essential runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libsqlite3-0 \
    procps \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/aarkam /etc/aarkam /workspace /app \
    && chmod 0755 /workspace

WORKDIR /workspace

# Copy verified release payload from dist/linux
COPY dist/linux/ /app/

# Ensure execution permissions on native binary and installer, and symlink to PATH
RUN chmod +x /app/am /app/install-am.sh 2>/dev/null || true \
    && ln -sf /app/am /usr/local/bin/am

# Environment defaults
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    ROKKA_COORDINATOR_URL="https://rokka-coordinator.aarkam:57774"

# Volumes for working directory, certificates, and runtime configuration
VOLUME ["/workspace", "/var/lib/aarkam", "/etc/aarkam"]

# Entrypoint runs am CLI; without arguments it drops into the interactive REPL shell
ENTRYPOINT ["/app/am"]
CMD []
